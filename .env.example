# Meta App Dashboard -> WhatsApp -> API Setup
# Temporary token expires in 24 h; use a system-user token for multi-day testing
WA_TOKEN=
# The test number's Phone number ID (not the phone number itself)
WA_PHONE_NUMBER_ID=
# Use the Graph API version shown in API Setup
GRAPH_VERSION=v24.0
# App settings -> Basic -> App secret (signs every webhook)
WA_APP_SECRET=
# Any string you choose; paste the same value into WhatsApp -> Configuration -> Verify token
WA_VERIFY_TOKEN=
# ElevenLabs -> Developers -> API Keys (the sk_... value; needs speech_to_text and text_to_speech)
ELEVENLABS_API_KEY=
# Uplift AI (sk_api_...) for Urdu answer audio; render_audio.py also needs ffmpeg on PATH
UPLIFT_API_KEY=
# Optional: swap in reviewed content without code changes
# CONTENT_PATH=content/hpv_placeholder.yaml
